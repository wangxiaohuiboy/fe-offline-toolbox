{
  "manifest_version": 3,
  "name": "前端离线工具箱",
  "version": "1.6.0",
  "description": "内网可用的前端工具箱：离线翻译（词典 + 本地神经整句翻译）、JSON、接口调试、命名转换、编解码等。作者：王耀辉 wangxiaohuiya@gmail.com",
  "author": "王耀辉 <wangxiaohuiya@gmail.com>",
  "homepage_url": "https://github.com/wangxiaohuiboy/fe-offline-toolbox",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "前端离线工具箱（点击打开面板）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "clipboardWrite", "activeTab", "scripting", "offscreen"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": [
        "js/lib/dict.data.js",
        "js/lib/translate-core.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "icons/*", "js/lib/pinyin.data.js", "js/lib/dict.big.js"],
      "matches": ["http://*/*", "https://*/*", "file://*/*"]
    }
  ],
  "commands": {
    "open-toolbox": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "在标签页中打开完整工具箱"
    }
  }
}
